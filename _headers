# Intestazioni applicate da Cloudflare (Worker con asset statici) a tutte le risposte.
# Ordine: prima le regole generali, poi le eccezioni per singolo percorso.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; frame-src 'none'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'

# Cache: i font non cambiano mai; le immagini si tengono un giorno, così una foto sostituita
# con lo stesso nome arriva a tutti entro 24 ore. CSS e JS usano stale-while-revalidate.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=86400

/css/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/nav.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/site.webmanifest
  Cache-Control: public, max-age=86400
